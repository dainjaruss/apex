{
  "name": "apex-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "package": "npm run build && rm -f apex-v2-forge.zip && (cd dist && zip -r -q ../apex-v2-forge.zip .) && echo '==> Packaged /srv/apex/v2/apex-v2-forge.zip ready for NMCI!'",
